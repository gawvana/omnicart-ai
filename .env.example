# ==============================================================================
# OmniCart AI — Environment Variables
# Copy to .env for local testing, or add to Vercel Project Settings > Environment Variables
# ==============================================================================

# ===== Telegram =====
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Public URL of your deployed app (e.g. https://omnicart.vercel.app)
TELEGRAM_WEBAPP_URL=https://your-omnicart.vercel.app
# Optional secret token sent in X-Telegram-Bot-Api-Secret-Token for webhook verification
TELEGRAM_WEBHOOK_SECRET=generate-a-32-char-random-string-for-webhook

# ===== Database (PostgreSQL) =====
# For Vercel hosting: Use Neon (neon.tech) or Supabase serverless PostgreSQL
# Neon connection string automatically converted to asyncpg:
DATABASE_URL=postgresql+asyncpg://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?ssl=require
# Or for local Docker:
# POSTGRES_USER=omnicart
# POSTGRES_PASSWORD=your_super_secret_postgres_password_here
# POSTGRES_DB=omnicart_db
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# ===== Redis =====
# For Vercel hosting: Use Upstash Redis (upstash.com) rediss://default:...@...upstash.io:6379
# Or for local Docker: redis://redis:6379/0
REDIS_URL=rediss://default:your-upstash-token@your-instance.upstash.io:6379

# ===== B.AI API =====
BAI_API_KEY=sk-your-bai-api-key
BAI_API_BASE=https://api.b.ai/v1
BAI_MODEL=gpt-4o

# ===== Security =====
SECRET_KEY=generate-a-64-char-hex-secret-here
RATE_LIMIT_PER_MINUTE=60
# Secret for Vercel Cron verification (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-random-cron-secret-here

# ===== App =====
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
